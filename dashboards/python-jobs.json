{
  "uid": "python-jobs",
  "title": "Python jobs (tryon-etl-python)",
  "description": "Python ETL jobs run by MWAA: status plus per-run counts. All jobs: \"ETL jobs overview\". dbt detail: \"dbt jobs\".",
  "tags": [
    "etl",
    "python",
    "mwaa"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "ETL jobs overview",
      "type": "link",
      "url": "/d/etl-overview",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "dbt jobs",
      "type": "link",
      "url": "/d/etl-jobs",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "category",
        "label": "Category",
        "type": "custom",
        "description": "Narrow by job type. Values are etl_job regexes.",
        "query": "All : py_.*,Payer exports : py_export_(aetna|bcbs|humana|novant|bamboo).*|py_payer_submission.*|py_cvsHealth.*,File ingestion : py_ingest_.*|py_route_source_files.*|py_cms_mssp.*,SharePoint / reports : py_vbm_.*|py_gohealth.*|py_email_sigma.*,Legacy DWH : py_transfer_legacy.*|py_daily_postgres.*,MedInsight : py_.*medinsight.*,Other transfers : py_export_biztech.*|py_humana_mft.*",
        "options": [
          {
            "text": "All",
            "value": "py_.*",
            "selected": true
          },
          {
            "text": "Payer exports",
            "value": "py_export_(aetna|bcbs|humana|novant|bamboo).*|py_payer_submission.*|py_cvsHealth.*",
            "selected": false
          },
          {
            "text": "File ingestion",
            "value": "py_ingest_.*|py_route_source_files.*|py_cms_mssp.*",
            "selected": false
          },
          {
            "text": "SharePoint / reports",
            "value": "py_vbm_.*|py_gohealth.*|py_email_sigma.*",
            "selected": false
          },
          {
            "text": "Legacy DWH",
            "value": "py_transfer_legacy.*|py_daily_postgres.*",
            "selected": false
          },
          {
            "text": "MedInsight",
            "value": "py_.*medinsight.*",
            "selected": false
          },
          {
            "text": "Other transfers",
            "value": "py_export_biztech.*|py_humana_mft.*",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": "py_.*"
        },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "etl_job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(etl_job_exit_code{etl_job=~\"$category\"}, etl_job)",
          "refId": "v"
        },
        "definition": "label_values(etl_job_exit_code{etl_job=~\"$category\"}, etl_job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "py_.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "stage",
        "label": "Stage",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(etl_rows{etl_job=~\"$category\"}, stage)",
          "refId": "v"
        },
        "definition": "label_values(etl_rows{etl_job=~\"$category\"}, stage)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failing now",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etl_job_exit_code{etl_job=~\"$etl_job\", etl_job=~\"$category\"} != 0) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs whose last run exited non-zero. Clears when the job next succeeds.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} > on (instance, etl_job) etl_job_expected_interval_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"}) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs with no success within their own expected interval. Jobs without an interval (manual / file-driven) are never stale.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running now",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} * 0) == 1) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs that started but have not finished, including a first-ever run.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Items failed (last runs)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Sum of every *_failed count from each job's last run (files, items, tables, emails). Partial failures show here even when the job itself succeeded.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\".*_failed\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "id": 5,
      "type": "table",
      "title": "Python jobs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (etl_job) (etl_job_exit_code{etl_job=~\"$etl_job\", etl_job=~\"$category\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (etl_job) (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} * 1000)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (etl_job) (time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "max by (etl_job) ((time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"}) / on (instance, etl_job) etl_job_expected_interval_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} * 100)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "max by (etl_job) (etl_job_duration_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "max by (etl_job) (etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} * 0))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "format": "table",
          "instant": true,
          "expr": "sum by (etl_job) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\".*_failed\"})"
        }
      ],
      "description": "One row per job. \"% of interval\" is time since success divided by the job's own expected interval, so hourly and weekly jobs are judged fairly (red at 100% = stale). Blank for jobs without an interval. \"Failed items\" sums the job's *_failed counts from its last run; blank if the script reports no counts.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "etl_job": 0,
              "Value #A": 1,
              "Value #F": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #G": 7
            },
            "renameByName": {
              "etl_job": "Job",
              "Value #A": "Status",
              "Value #F": "Running",
              "Value #B": "Last run",
              "Value #C": "Since success",
              "Value #D": "% of interval",
              "Value #E": "Duration",
              "Value #G": "Failed items"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "% of interval",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 255,
                      "result": {
                        "text": "FAILED",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "",
                        "index": 0
                      },
                      "1": {
                        "text": "running",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of interval"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed items"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Last run counts (job \u00d7 stage)",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "What each job's last run did, one column per stage. Blank = that job doesn't report that stage.",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "max by (etl_job, stage) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\"$stage\"})"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "stage",
            "rowField": "etl_job",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "etl_job\\stage": "Job"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          },
          "unit": "short",
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_failed"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Items processed per run",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Count per job and stage, stepping at each run. Values are per run, not cumulative. Narrow with the Stage picker.",
      "targets": [
        {
          "refId": "A",
          "expr": "max by (etl_job, stage) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\"$stage\"})",
          "legendFormat": "{{etl_job}} / {{stage}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "bargauge",
      "title": "Failures within runs",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Failed items in each job's last run, only where non-zero.",
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{etl_job}} / {{stage}}",
          "expr": "max by (etl_job, stage) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\".*_failed\"}) > 0"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No failures",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Volume change vs 7 days ago",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Last-run count minus the count 7 days earlier (7d, not 1d: many jobs are weekly or monthly). Red = drop, green = growth. Blank until a job has 7 days of history.",
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "max by (etl_job, stage) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\"$stage\"})"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "max by (etl_job, stage) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\"$stage\"}) - max by (etl_job, stage) (etl_rows{etl_job=~\"$etl_job\", etl_job=~\"$category\", stage=~\"$stage\"} offset 7d)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "etl_job": 0,
              "stage": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "etl_job": "Job",
              "stage": "Stage",
              "Value #A": "Last run",
              "Value #B": "vs 7 days ago"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "vs 7 days ago",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vs 7 days ago"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "id": 9
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Run history",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((max by (etl_job) (etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\", etl_job=~\"$category\"} * 0))) == 1) - 2 or max by (etl_job) (etl_job_exit_code{etl_job=~\"$etl_job\", etl_job=~\"$category\"})",
          "legendFormat": "{{etl_job}}",
          "interval": "1m"
        }
      ],
      "description": "Blue = running, green = last run succeeded, red = last run failed. Each band lasts until the next run. Runs shorter than the query step (\u22481m) may not show as blue.",
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "running",
                  "color": "blue",
                  "index": 0
                },
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 255,
                "result": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Duration trend",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
