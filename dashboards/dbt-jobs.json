{
  "uid": "etl-jobs",
  "title": "dbt jobs (tryon-etl-python)",
  "tags": [
    "etl",
    "dbt",
    "mwaa"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "etl_job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(etl_job_exit_code{etl_job=~\"dbt_.*\"}, etl_job)",
          "refId": "etl_job"
        },
        "definition": "label_values(etl_job_exit_code{etl_job=~\"dbt_.*\"}, etl_job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "dbt_.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(dbt_node_rows_affected{etl_job=~\"$etl_job\"}, node)",
          "refId": "node"
        },
        "definition": "label_values(dbt_node_rows_affected{etl_job=~\"$etl_job\"}, node)",
        "description": "Type to search. Scoped to the selected job(s). Filters the rows-affected panels.",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last run result",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etl_job_exit_code{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}",
          "instant": true
        }
      ],
      "description": "Exit code of each job's last run. 0 = OK.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hours since last success",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"}) / 3600",
          "legendFormat": "{{etl_job}}",
          "instant": true
        }
      ],
      "description": "Orange past 24h, red past 26h (sized for daily jobs). EtlJobStale alerts on each job's own expected interval.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 24
              },
              {
                "color": "red",
                "value": 26
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running now",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} * 0)",
          "legendFormat": "{{etl_job}}",
          "instant": true
        }
      ],
      "description": "1 while a job has started but not finished, including its first-ever run (no last_run yet).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "transparent",
                  "index": 0
                },
                "1": {
                  "text": "running",
                  "color": "blue",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Time since last dbt build",
      "description": "When node metrics below were last refreshed. Jobs that skip their build when there is no new data (fpna_event) keep showing their last build's nodes.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - dbt_build_last_timestamp_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Job duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etl_job_duration_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}"
        }
      ],
      "description": "Wall clock of the last run, including nix develop + dbt debug/deps. Watch for creep toward the MWAA task timeout.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "dbt build elapsed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbt_build_elapsed_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}"
        }
      ],
      "description": "dbt's own elapsed time for the build step only.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Slowest nodes (last build)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, dbt_node_execution_seconds{etl_job=~\"$etl_job\"})",
          "legendFormat": "{{etl_job}} / {{node}} ({{resource_type}})",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Failing or erroring dbt nodes (last build)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbt_node_status{etl_job=~\"$etl_job\", status=~\"fail|error|warn|skipped\"}",
          "format": "table",
          "instant": true
        }
      ],
      "description": "Empty is good. Shows tests that failed/warned and models that errored or were skipped.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "instance_id": true,
              "job": true
            },
            "indexByName": {
              "etl_job": 0,
              "resource_type": 1,
              "node": 2,
              "status": 3
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Rows affected per model (last build)",
      "description": "Sort by any column; use the funnel on Model to filter by name. \"vs 24h ago\" is blank when the model has no value 24h earlier.",
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"} - dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"} offset 1d",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "instance_id": true,
              "job": true,
              "resource_type": true
            },
            "indexByName": {
              "etl_job": 0,
              "node": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "etl_job": "Job",
              "node": "Model",
              "Value #A": "Rows",
              "Value #B": "vs 24h ago"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Rows",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vs 24h ago"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Rows affected trend (top 15 of selected models)",
      "description": "Pick models in the Model variable to compare them. With Model = All, only the 15 largest are drawn at each point in time.",
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 10,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"})",
          "legendFormat": "{{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "ETL jobs overview",
      "type": "link",
      "url": "/d/etl-overview",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Python jobs",
      "type": "link",
      "url": "/d/python-jobs",
      "icon": "dashboard",
      "keepTime": true
    }
  ]
}
