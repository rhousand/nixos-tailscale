{
  "uid": "etl-jobs",
  "title": "dbt jobs (tryon-etl-python)",
  "tags": [
    "etl",
    "dbt",
    "mwaa"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "etl_job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(etl_job_exit_code{etl_job=~\"dbt_.*\"}, etl_job)",
          "refId": "etl_job"
        },
        "definition": "label_values(etl_job_exit_code{etl_job=~\"dbt_.*\"}, etl_job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "dbt_.*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "node",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(dbt_node_rows_affected{etl_job=~\"$etl_job\"}, node)",
          "refId": "node"
        },
        "definition": "label_values(dbt_node_rows_affected{etl_job=~\"$etl_job\"}, node)",
        "description": "Type to search. Scoped to the selected job(s). Filters the rows-affected panels.",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failing now",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etl_job_exit_code{etl_job=~\"$etl_job\"} != 0) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs whose last run exited non-zero. Clears when the job next succeeds.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"} > on (instance, etl_job) etl_job_expected_interval_seconds{etl_job=~\"$etl_job\"}) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs with no success within their own expected interval. Jobs without an interval (manual / file-driven) are never stale.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running now",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} * 0) == 1) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs that started but have not finished, including a first-ever run.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "dbt tests failing",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "dbt tests that failed or errored in each job's last build. Same signal as the DbtTestsFailing alert.",
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(dbt_nodes_total{etl_job=~\"$etl_job\", resource_type=\"test\", status=~\"fail|error\"}) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "id": 5,
      "type": "table",
      "title": "dbt jobs",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((max by (etl_job) (etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} * 0))) == 1) - 2 or max by (etl_job) (etl_job_exit_code{etl_job=~\"$etl_job\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (etl_job) (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} * 1000)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (etl_job) (time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "max by (etl_job) ((time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"}) / on (instance, etl_job) etl_job_expected_interval_seconds{etl_job=~\"$etl_job\"} * 100)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "max by (etl_job) (etl_job_duration_seconds{etl_job=~\"$etl_job\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "format": "table",
          "instant": true,
          "expr": "sum by (etl_job) (dbt_nodes_total{etl_job=~\"$etl_job\", resource_type=\"test\", status=~\"fail|error\"}) or sum by (etl_job) (dbt_nodes_total{etl_job=~\"$etl_job\", resource_type=\"test\"}) * 0"
        }
      ],
      "description": "One row per dbt job. Status: blue RUNNING while a run is in progress, otherwise green OK / red FAILED for the last run. \"% of interval\" is time since success divided by the job's own expected interval, so weekly jobs (e.g. Athena) only turn red when they actually miss their week. Blank for jobs without an interval (e.g. manual ffs). \"Failed tests\" is from the job's last build.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "etl_job": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #G": 6
            },
            "renameByName": {
              "etl_job": "Job",
              "Value #A": "Status",
              "Value #B": "Last run",
              "Value #C": "Since success",
              "Value #D": "% of interval",
              "Value #E": "Duration",
              "Value #G": "Failed tests"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "% of interval",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "RUNNING",
                        "color": "blue",
                        "index": 0
                      },
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 255,
                      "result": {
                        "text": "FAILED",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of interval"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed tests"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Time since last dbt build",
      "description": "When node metrics below were last refreshed. Jobs that skip their build when there is no new data (fpna_event) keep showing their last build's nodes.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - dbt_build_last_timestamp_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Job duration",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etl_job_duration_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}"
        }
      ],
      "description": "Wall clock of the last run, including nix develop + dbt debug/deps. Watch for creep toward the MWAA task timeout.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "dbt build elapsed",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbt_build_elapsed_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}"
        }
      ],
      "description": "dbt's own elapsed time for the build step only.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Slowest nodes (last build)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, dbt_node_execution_seconds{etl_job=~\"$etl_job\"})",
          "legendFormat": "{{etl_job}} / {{node}} ({{resource_type}})",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Failing or erroring dbt nodes (last build)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbt_node_status{etl_job=~\"$etl_job\", status=~\"fail|error|warn|skipped\"}",
          "format": "table",
          "instant": true
        }
      ],
      "description": "Empty is good. Shows tests that failed/warned and models that errored or were skipped.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "instance_id": true,
              "job": true
            },
            "indexByName": {
              "etl_job": 0,
              "resource_type": 1,
              "node": 2,
              "status": 3
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Rows affected per model (last build)",
      "description": "Sort by any column; use the funnel on Model to filter by name. \"vs 24h ago\" is blank when the model has no value 24h earlier.",
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"} - dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"} offset 1d",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "instance_id": true,
              "job": true,
              "resource_type": true
            },
            "indexByName": {
              "etl_job": 0,
              "node": 1,
              "Value #A": 2,
              "Value #B": 3
            },
            "renameByName": {
              "etl_job": "Job",
              "node": "Model",
              "Value #A": "Rows",
              "Value #B": "vs 24h ago"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Rows",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vs 24h ago"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": 0
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Rows affected trend (top 15 of selected models)",
      "description": "Pick models in the Model variable to compare them. With Model = All, only the 15 largest are drawn at each point in time.",
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 10,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, dbt_node_rows_affected{etl_job=~\"$etl_job\", node=~\"$node\"})",
          "legendFormat": "{{node}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "ETL jobs overview",
      "type": "link",
      "url": "/d/etl-overview",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Python jobs",
      "type": "link",
      "url": "/d/python-jobs",
      "icon": "dashboard",
      "keepTime": true
    }
  ]
}
