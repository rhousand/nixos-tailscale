{
  "uid": "etl-overview",
  "title": "ETL jobs overview (tryon-etl-python)",
  "description": "All ETL jobs (dbt + Python). Per-model detail: \"dbt jobs (tryon-etl-python)\".",
  "tags": [
    "etl",
    "mwaa"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "dbt jobs",
      "type": "link",
      "url": "/d/etl-jobs",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Python jobs",
      "type": "link",
      "url": "/d/python-jobs",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "etl_job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(etl_job_exit_code, etl_job)",
          "refId": "etl_job"
        },
        "definition": "label_values(etl_job_exit_code, etl_job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failing now",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etl_job_exit_code{etl_job=~\"$etl_job\"} != 0) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs whose last run exited non-zero. Clears when the job next succeeds.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stale",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"} > on (instance, etl_job) etl_job_expected_interval_seconds{etl_job=~\"$etl_job\"}) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs with no success within their own expected interval. Jobs without an interval (manual / file-driven) are never stale.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running now",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} * 0) == 1) or vector(0)",
          "instant": true
        }
      ],
      "description": "Jobs that started but have not finished, including a first-ever run.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "All jobs",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (etl_job) (etl_job_exit_code{etl_job=~\"$etl_job\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (etl_job) (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} * 1000)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (etl_job) (time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "max by (etl_job) ((time() - etl_job_last_success_timestamp_seconds{etl_job=~\"$etl_job\"}) / on (instance, etl_job) etl_job_expected_interval_seconds{etl_job=~\"$etl_job\"} * 100)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "max by (etl_job) (etl_job_duration_seconds{etl_job=~\"$etl_job\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "max by (etl_job) (etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} * 0))",
          "format": "table",
          "instant": true
        }
      ],
      "description": "One row per job. \"% of interval\" is time since success divided by the job's own expected interval, so hourly and weekly jobs are judged fairly (red at 100% = stale). Blank for jobs without an interval.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "etl_job": 0,
              "Value #A": 1,
              "Value #F": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6
            },
            "renameByName": {
              "etl_job": "Job",
              "Value #A": "Status",
              "Value #F": "Running",
              "Value #B": "Last run",
              "Value #C": "Since success",
              "Value #D": "% of interval",
              "Value #E": "Duration"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "% of interval",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 255,
                      "result": {
                        "text": "FAILED",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Running"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "",
                        "index": 0
                      },
                      "1": {
                        "text": "running",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Since success"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of interval"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 100
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Run history",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((max by (etl_job) (etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} > bool (etl_job_last_run_timestamp_seconds{etl_job=~\"$etl_job\"} or etl_job_last_start_timestamp_seconds{etl_job=~\"$etl_job\"} * 0))) == 1) - 2 or max by (etl_job) (etl_job_exit_code{etl_job=~\"$etl_job\"})",
          "legendFormat": "{{etl_job}}",
          "interval": "1m"
        }
      ],
      "description": "Blue = running, green = last run succeeded, red = last run failed. Each band lasts until the next run. Runs shorter than the query step (\u22481m) may not show as blue.",
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "running",
                  "color": "blue",
                  "index": 0
                },
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 255,
                "result": {
                  "text": "FAILED",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Duration trend",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etl_job_duration_seconds{etl_job=~\"$etl_job\"}",
          "legendFormat": "{{etl_job}}"
        }
      ],
      "description": "Wall clock of each job's last run. Watch for creep toward the task's MWAA/SSM timeout.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineInterpolation": "stepAfter"
          }
        },
        "overrides": []
      }
    }
  ]
}
